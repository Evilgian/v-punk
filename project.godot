; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="V-Punk: Rogue Protocol"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/player_placeholder.png"

[autoload]

Global="*res://scripts/global.gd"
WeaponDB="*res://scripts/weapon_database.gd"
PerkDB="*res://scripts/perk_database.gd"
WorldDB="*res://scripts/world_database.gd"
SoundFX="*res://scripts/sound_fx.gd"
RewardManager="*res://scripts/reward_manager.gd"
InventoryManager="*res://scripts/inventory_manager.gd"
TalentManager="*res://scripts/talent_manager.gd"
SaveSystem="*res://scripts/save_system.gd"
VFXManager="*res://scripts/vfx_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
